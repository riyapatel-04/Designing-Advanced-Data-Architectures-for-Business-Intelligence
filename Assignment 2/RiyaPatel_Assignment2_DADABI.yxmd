    <Node ToolID="16">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="570" y="222" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>(
  ToString([GEO_Summary]) IN ("Domestic","International")
)
AND
(
  ToString([GEO_Region]) IN (
    "US","Africa","Asia","Australia/Oceania","Canada","Caribbean",
    "Central America","Europe","Mexico","Middle East","South America"
  )
)
AND
(
  ToString([Landing_Aircraft_Type]) IN ("Passenger","Freighter","Combi")
)
AND
(
  ToString([Aircraft_Body_Type]) IN ("Wide Body","Narrow Body","Regional Jet","Turbo Prop")
)
AND
(
  ToString([Aircraft_Manufacturer]) IN (
    "Boeing","Airbus","Antonov","McDonnell Douglas","Embraer","Bombardier",
    "ATR","BAE-Avro","Beechcraft","Cessna","Convair","DeHavilland","Dessault-Falcon",
    "Dornier","Fairchild","Fokker","IAI","Ilyushin","LearJet","Lockheed","Mitsubishi",
    "Piper","SAAB","Shorts","Swearingen"
  )
)
AND
(
  // Activity_Period numeric validation
  NOT IsNull([Activity_Period])
  AND ToNumber([Activity_Period]) &gt;= 200507
  AND Between(Mod(ToNumber([Activity_Period]), 100), 1, 12)
)
AND
(
  // Fact fields non-negative (cast just in case)
  ToNumber([Landing_Count]) &gt;= 0
  AND ToNumber([Total_Landed_Weight]) &gt;= 0
)</Expression>
          <Mode>Custom</Mode>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>(
  ToString([GEO_Summary]) IN ("Domestic","International")
)
AND
(
  ToString([...</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFilter" />
    </Node>
